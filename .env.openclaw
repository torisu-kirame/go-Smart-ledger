# OpenClaw + Ollama stack (docker-compose.openclaw.yml)
# Copy: cp .env.openclaw.example .env.openclaw
# Setup: ./scripts/setup-openclaw-docker.sh  (or setup-openclaw-docker.ps1)

# Pre-built image (default). Local build: clone openclaw/ then OPENCLAW_IMAGE=openclaw:local
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
OPENCLAW_GATEWAY_BIND=lan
# Generated by setup script if empty:
OPENCLAW_GATEWAY_TOKEN=

OPENCLAW_TZ=Asia/Shanghai
OPENCLAW_DISABLE_BONJOUR=1

# Comma-separated; pulled on first setup when Ollama is ready
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Smart Ledger API from inside OpenClaw container (host gateway publish)
SMART_LEDGER_GATEWAY=http://host.docker.internal:28080
OPENCLAW_GATEWAY_TOKEN=fa97bb5d95c0a692f73bc6c66bb33a8fba5347aa2a9de866
