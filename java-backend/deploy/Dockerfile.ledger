# syntax=docker/dockerfile:1

FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /build
COPY pom.xml .
COPY common/pom.xml common/
COPY auth-service/pom.xml auth-service/
COPY ledger-service/pom.xml ledger-service/
COPY storage-service/pom.xml storage-service/
COPY gateway-service/pom.xml gateway-service/
COPY agent-service/pom.xml agent-service/
COPY common/src common/src
COPY ledger-service/src ledger-service/src
RUN mvn -pl ledger-service -am package -DskipTests -q

FROM eclipse-temurin:21-jre-alpine
RUN apk add --no-cache wget
WORKDIR /app
COPY --from=build /build/ledger-service/target/ledger-service-*.jar app.jar
EXPOSE 28888
ENTRYPOINT ["java", "-jar", "app.jar"]
