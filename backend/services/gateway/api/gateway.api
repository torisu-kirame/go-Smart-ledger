syntax = "v1"

info (
	title:   "API Gateway"
	desc:    "Unified entry for Smart Ledger microservices"
	author:  "smart-ledger"
	version: "v1"
)

type (
	HealthResp {
		Status  string `json:"status"`
		Gateway string `json:"gateway"`
	}
)

@server (
	prefix: /api/v1
)
service gateway-api {
	@handler health
	get /health returns (HealthResp)
}

