# 需先在外部编译: make build-linux 或 make build-linux-ledger
# 仅复制 Linux 二进制，不在镜像内编译
FROM alpine:3.20

RUN apk add --no-cache ca-certificates wget

WORKDIR /app

ARG BIN=bin/linux/ledger-api
COPY ${BIN} ./ledger-api
COPY deploy/etc/ledger-api.docker.yaml etc/ledger-api.yaml

EXPOSE 28888
CMD ["./ledger-api", "-f", "etc/ledger-api.yaml"]
