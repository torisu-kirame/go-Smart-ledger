# 需先编译: make build-linux-gateway 或 make build-linux
FROM alpine:3.20

RUN apk add --no-cache ca-certificates wget

WORKDIR /app

ARG BIN=bin/linux/gateway-api
COPY ${BIN} ./gateway-api
COPY deploy/etc/gateway-api.docker.yaml etc/gateway-api.yaml

EXPOSE 28080
CMD ["./gateway-api", "-f", "etc/gateway-api.yaml"]
