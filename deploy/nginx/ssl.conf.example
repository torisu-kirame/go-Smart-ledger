# HTTPS server (F27). Mount as /etc/nginx/conf.d/ssl.conf with certs in /etc/nginx/certs/
server {
    listen 443 ssl;
    server_name localhost;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 32m;

    location /api/ {
        proxy_pass http://gateway-api:28080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /dashboard/ {
        proxy_pass http://miniledger:24441/dashboard/;
        proxy_http_version 1.1;
        proxy_set_header Host miniledger:24441;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ~ ^/(status|blocks|tx|state|peers|consensus|search|contracts|proposals|identity)(/|$) {
        proxy_pass http://miniledger:24441;
        proxy_http_version 1.1;
        proxy_set_header Host miniledger:24441;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /explorer-zh/ {
        try_files $uri $uri/ /explorer-zh/index.html;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 80;
    return 301 https://$host$request_uri;
}
