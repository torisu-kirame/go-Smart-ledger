# Default: let Git normalize text; explicit rules below override per extension.
* text=auto

# Shell entrypoints run in Linux containers — must stay LF.
*.sh text eol=lf
*.bash text eol=lf

# Keep source and deploy configs LF for CI/Docker consistency.
*.go text eol=lf
Dockerfile text eol=lf
*.dockerfile text eol=lf
Makefile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.html text eol=lf
*.conf text eol=lf
*.sql text eol=lf
*.toml text eol=lf
*.env.example text eol=lf
.editorconfig text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
