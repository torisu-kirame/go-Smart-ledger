# Smart Ledger production / optional overrides (F27, F29)
# Copy to .env and set values before `docker compose up`.

# --- F27: secrets & cookies ---
SL_ENV=development
# SL_ENV=production
SL_ACCESS_SECRET=change-me-to-random-64-chars
SL_REFRESH_SECRET=change-me-to-another-random-secret
SL_COOKIE_SECURE=false
# SL_COOKIE_DOMAIN=.example.com

# --- FISCO BCOS 3.0（v0.18+ 默认链；部署 LedgerRegistry 后填写）---
# SL_FISCO_REGISTRY=0x...
# SL_FISCO_PRIVATE_KEY=0x...
# SL_FISCO_JSONRPC=http://host.docker.internal:20200
# SL_FISCO_GROUP_ID=group0
# SL_FISCO_DISABLE_SSL=true

# MiniLedger 回退（配合 docker-compose.legacy.yml --profile legacy）：
# SL_CHAIN_BACKEND=miniledger

# --- F29: EVM / L2 external anchor (optional) ---
SL_EVM_ANCHOR_ENABLED=false
# SL_EVM_RPC_URL=http://anvil:8545
# SL_EVM_CHAIN_ID=31337
# SL_EVM_CONTRACT=0x5FbDB2315678afecb367f032d93F642f64180aa3
# SL_EVM_ANCHOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
