# 需先编译: make build-linux-ledger 或 make build-linux（根目录 make up 会自动执行）
# 多阶段镜像内编译见 Dockerfile.ledger.multistage（需 Docker 可访问 go module 代理）
FROM alpine:3.20

RUN apk add --no-cache ca-certificates wget

WORKDIR /app

ARG BIN=bin/linux/ledger-api
COPY ${BIN} ./ledger-api
COPY deploy/etc/ledger-api.docker.yaml etc/ledger-api.yaml

EXPOSE 28888
CMD ["./ledger-api", "-f", "etc/ledger-api.yaml"]
