# OpenClaw + Ollama（已并入 docker-compose.yml，make up 自动启动）
# Copy: cp .env.openclaw.example .env.openclaw  （make up 也会自动创建）
# 首次启动会拉取 Ollama 模型，可能需数分钟

OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
OPENCLAW_GATEWAY_BIND=lan
# 由 init-openclaw-config 脚本生成（若为空）:
OPENCLAW_GATEWAY_TOKEN=

OPENCLAW_TZ=Asia/Shanghai
OPENCLAW_DISABLE_BONJOUR=1

OLLAMA_HOST_PORT=11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# OpenClaw 容器内访问 Smart Ledger 网关（同 compose 网络）
SMART_LEDGER_GATEWAY=http://gateway-api:28080
